# ─────────────────────────────────────────────────────────────────────────
#  API del ERP (Bloque 5, 2026-08-29)
# ─────────────────────────────────────────────────────────────────────────
# Sin estas dos variables, el sitio usa data/productos.json y
# data/categorias.json (la última foto que exportó el ERP) en vez del
# catálogo en vivo. Ver lib/data.ts para el detalle.
#
# El token se genera en el ERP (no se comparte ni se inventa uno):
#   python manage.py shell -c "
#   from django.contrib.auth.models import User
#   from rest_framework.authtoken.models import Token
#   u, _ = User.objects.get_or_create(username='sitio-web')
#   print(Token.objects.get_or_create(user=u)[0].key)"
#
# NUNCA lleva el prefijo NEXT_PUBLIC_: si lo tuviera, Next.js lo mandaría al
# navegador del cliente, y el token dejaría de ser un secreto de servidor.
ERP_API_URL=http://localhost:8000
ERP_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
#  Webhook de pago (Bloque 5)
# ─────────────────────────────────────────────────────────────────────────
# Secreto compartido con la pasarela de pago para verificar la firma HMAC
# de cada webhook. Sin credenciales reales todavía (ver REPORTE-NOCHE.md):
# esto es la firma GENÉRICA que arma la infraestructura, no la de un
# proveedor específico.
PAGO_WEBHOOK_SECRET=
